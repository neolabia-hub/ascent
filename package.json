{
  "name": "neo-pulse",
  "private": true,
  "version": "0.1.0",
  "description": "NEO PULSE — Plataforma SaaS de formacion corporativa multi-tenant (NEO IO). Cliente piloto: TRANSPRENSA",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @neo-pulse/api prisma:generate",
    "db:migrate": "pnpm --filter @neo-pulse/api prisma:migrate",
    "db:rls": "pnpm --filter @neo-pulse/api db:rls",
    "db:seed": "pnpm --filter @neo-pulse/api db:seed",
    "db:seed:demo": "pnpm --filter @neo-pulse/api db:seed:demo",
    "db:verify-rls": "pnpm --filter @neo-pulse/api db:verify-rls",
    "db:studio": "pnpm --filter @neo-pulse/api prisma:studio",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@next/eslint-plugin-next": "^15.0.0",
    "@playwright/test": "^1.48.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0"
  }
}
