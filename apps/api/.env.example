# Copia a .env y ajusta. NUNCA commitear .env real.

# --- Database / Redis (dev: docker/docker-compose.yml, puertos 5433/6380) ---
# Usuario de la APP (NO superusuario) -> sujeto a RLS (defensa en profundidad, Decision #17).
DATABASE_URL=postgresql://neopulse_app:neopulse_app@localhost:5433/neopulse?schema=public
# Usuario para migraciones/seed (owner del schema, no sujeto a RLS).
DIRECT_DATABASE_URL=postgresql://neopulse:neopulse_dev@localhost:5433/neopulse?schema=public
REDIS_URL=redis://localhost:6380

# --- Auth (JWT RS256) ---
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
REFRESH_TOKEN_PEPPER=change-me-in-prod
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

# --- Storage ---
# Desarrollo: disco local. Produccion: Cloudflare R2 (egress cero; decisivo por el video).
# Si R2_BUCKET_NAME y R2_ACCESS_KEY_ID estan definidos, la app usa R2; si no, disco local.
LOCAL_STORAGE_DIR=./storage-dev
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@neopulse.app

# --- IA (generacion de borradores; humano aprueba siempre) ---
ANTHROPIC_API_KEY=

# --- App ---
NODE_ENV=development
PORT=3002
FRONTEND_URL=http://localhost:3100
PUBLIC_VERIFY_BASE_URL=http://localhost:3100/verificar
APP_TIMEZONE=America/Bogota

# --- Observabilidad (opcional; sin DSN no hace nada) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
