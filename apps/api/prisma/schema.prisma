  status      EnrollmentStatus @default(ENROLLED)
  progressPct Int              @default(0) @map("progress_pct")
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@unique([pathId, userId])
  @@map("path_enrollments")
}

// ──────────────────── 6.9 Evaluaciones ────────────────────

model QuestionCategory {
  id       String             @id @default(uuid()) @db.Uuid
  tenantId String             @map("tenant_id") @db.Uuid
  parentId String?            @map("parent_id") @db.Uuid
  parent   QuestionCategory?  @relation("QuestionCategoryTree", fields: [parentId], references: [id])
  children QuestionCategory[] @relation("QuestionCategoryTree")
  name     String

  questions Question[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("question_categories")
}

model Question {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  // El TEMA es opcional (Decision #84): solo hace falta para los bloques al azar, que sacan
  // N preguntas de un tema. Obligarlo ponia una ceremonia delante de la primera pregunta.
  categoryId       String?           @map("category_id") @db.Uuid
  category         QuestionCategory? @relation(fields: [categoryId], references: [id])
  currentVersionId String?           @unique @map("current_version_id") @db.Uuid
  active           Boolean           @default(true)

  versions QuestionVersion[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, categoryId, active])
  @@map("questions")
}

// INMUTABLE (Decision #6): editar = version nueva.
model QuestionVersion {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  questionId    String       @map("question_id") @db.Uuid
  question      Question     @relation(fields: [questionId], references: [id])
  versionNumber Int          @map("version_number")
  qtype         QuestionType
  stem          String
  options       Json         @default("[]")
  correct       Json         @default("{}") // NUNCA viaja al cliente
  feedback      Json         @default("{}")
  points        Decimal      @default(1) @db.Decimal(6, 2)
  createdBy     String?      @map("created_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")

  attemptQuestions AttemptQuestion[]

  @@unique([questionId, versionNumber])
  @@index([questionId, versionNumber])
  @@map("question_versions")
}

// UNA EVALUACION ES UN OBJETO PLANO, como una leccion (Decision #87).
//
// ANTES tenia su propia escalera de versiones (`assessment_versions`), y eso era una SEGUNDA
// solucion al mismo problema que la formacion ya resolvia. Las dos escaleras no estaban
// sincronizadas, y de ahi salian cuatro danos, uno de ellos capaz de romper el examen en
// produccion:
//
//   1. publicar la v2 ponia la v1 en RETIRED, pero el contenido de la formacion seguia apuntando
//      a la v1 —y `attempts.start` exige PUBLISHED—: el examen dejaba de poder abrirse para
//      TODAS las formaciones publicadas que la usaran;
//   2. los intentos se contaban por VERSION, asi que publicar una version nueva le regalaba
//      intentos a todo el mundo y deshacia el "ya aprobaste";
//   3. la completitud miraba `assessmentVersionId`, asi que repuntar el contenido dejaba
//      incompleto a quien ya habia aprobado;
//   4. quien administra tenia que sostener dos escaleras de versiones en la cabeza a la vez.
//
// AHORA se hace lo mismo que con las lecciones, que nunca dieron ninguno de esos problemas: la
// evaluacion se edita libremente, y publicar la FORMACION congela una COPIA. La inmutabilidad la
// da el unico escalon que de verdad la necesita —la version de la formacion—, y el historico de
// lo respondido lo sigue dando `question_versions`, que es donde siempre estuvo (Decision #6).
// UNA PERSONA PUEDE TENER VARIAS SESIONES A LA VEZ (Decision #91).
//
// El refresco vivia en una columna de `users`, asi que solo cabia UNA sesion: entrar desde el
// telefono cerraba la del computador, y una segunda pestana o cualquier segundo login tumbaba la
// primera al cabo de quince minutos —cuando caducaba el token de acceso y el refresco ya no valia—.
// Eso es lo que se veia como "se cerro sola sin motivo".
//
// Ahora cada sesion es una FILA: se cierra la suya y no la de los demas.
model UserSession {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 del token de refresco. El token en claro solo existe en la cookie del navegador.
  tokenHash String @map("token_hash")

  /// EL TOKEN ANTERIOR, valido unos segundos mas (`previousValidUntil`).
  ///
  /// El refresco ROTA el token, y dos pestanas que refrescan a la vez se invalidarian entre si:
  /// la primera rota, la segunda presenta el viejo y se queda fuera. Con una ventana de gracia,
  /// la segunda entra igual. Es lo minimo para que el rotado no cueste sesiones.
  previousHash       String?   @map("previous_hash")
  previousValidUntil DateTime? @map("previous_valid_until")

  /// Para que la persona pueda reconocer sus sesiones si algun dia se listan.
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  @@index([userId, expiresAt])
  @@index([tokenHash])
  @@map("user_sessions")
}

model Assessment {
  id       String        @id @default(uuid()) @db.Uuid
  tenantId String        @map("tenant_id") @db.Uuid
  title    String
  /// DRAFT = la que se edita en /evaluaciones. PUBLISHED = una copia congelada dentro de una
  /// version de formacion; no sale en el listado y no se edita. Igual que en `lessons`.
  status   VersionStatus @default(DRAFT)

  /// Las reglas del examen. Vivian en la version; al no haber versiones, viven aqui y se
  /// congelan con la copia.
  timeLimitMin     Int?          @map("time_limit_min")
  maxAttempts      Int?          @map("max_attempts") // NULL = hereda de activity_version
  gradingPolicy    GradingPolicy @default(HIGHEST) @map("grading_policy")
  passingScore     Int?          @map("passing_score") // NULL = hereda
  shuffleQuestions Boolean       @default(true) @map("shuffle_questions")
  shuffleOptions   Boolean       @default(true) @map("shuffle_options")
  reviewPolicy     Json          @default("{}") @map("review_policy")

  /// COMO SE VE el examen para quien lo rinde: ritmo, acento, fondo, transicion (Decision #85).
  /// No es evidencia —no cambia que se pregunto ni como se califico—, y por eso es lo unico que
  /// se puede retocar sin publicar la formacion de nuevo: la copia congelada lo LEE de su origen.
  presentation Json @default("{}")

  /// De que evaluacion editable salio esta copia. NULL en la editable. Es lo que permite que un
  /// retoque de presentacion llegue a las copias sin tocar nada mas.
  sourceId String?      @map("source_id") @db.Uuid
  source   Assessment?  @relation("AssessmentCopias", fields: [sourceId], references: [id])
  copias   Assessment[] @relation("AssessmentCopias")

  sections AssessmentSection[]
  attempts Attempt[]
  contents ActivityContent[]

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([tenantId, status, updatedAt])
  @@index([sourceId])
  @@map("assessments")
}

model AssessmentSection {
  id                      String      @id @default(uuid()) @db.Uuid
  tenantId                String      @map("tenant_id") @db.Uuid
  assessmentId            String      @map("assessment_id") @db.Uuid
  assessment              Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  mode                    SectionMode
  categoryId              String?     @map("category_id") @db.Uuid
  pickCount               Int?        @map("pick_count")
  fixedQuestionVersionIds String[]    @default([]) @map("fixed_question_version_ids") @db.Uuid
  displayOrder            Int         @default(0) @map("display_order")

  @@index([assessmentId, displayOrder])
  @@map("assessment_sections")
}

model Attempt {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  enrollmentId  String        @map("enrollment_id") @db.Uuid
  enrollment    Enrollment    @relation(fields: [enrollmentId], references: [id])
  assessmentId  String        @map("assessment_id") @db.Uuid
  assessment    Assessment    @relation(fields: [assessmentId], references: [id])
  userId        String        @map("user_id") @db.Uuid
  user          User          @relation(fields: [userId], references: [id])
  attemptNumber Int           @map("attempt_number")
  status        AttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime      @default(now()) @map("started_at")
  submittedAt   DateTime?     @map("submitted_at")
  score         Decimal?      @db.Decimal(5, 2)
  passed        Boolean?
  anomalyFlags  Json?         @map("anomaly_flags") // completitud en tiempo anomalo, etc.

  questions AttemptQuestion[]

  @@unique([enrollmentId, assessmentId, attemptNumber])
  @@index([enrollmentId, attemptNumber])
  @@map("attempts")
}

// SNAPSHOT de lo servido (Decision #7): la defensa ante impugnaciones.
model AttemptQuestion {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  attemptId         String          @map("attempt_id") @db.Uuid
  attempt           Attempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionVersionId String          @map("question_version_id") @db.Uuid
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id])
  displayOrder      Int             @map("display_order")
  optionsOrder      Json            @default("[]") @map("options_order")
  answer            Json?
  pointsPossible    Decimal         @map("points_possible") @db.Decimal(6, 2)
  pointsAwarded     Decimal?        @map("points_awarded") @db.Decimal(6, 2)
  gradedBy          String?         @map("graded_by") @db.Uuid
  gradedAt          DateTime?       @map("graded_at")
  invalidated       Boolean         @default(false) // anular y recalificar

  @@index([attemptId, displayOrder])
  @@map("attempt_questions")
}

// ──────────────────── 6.10 Encuestas y eficacia ────────────────────

model SurveyTemplate {
  id                 String     @id @default(uuid()) @db.Uuid
  tenantId           String     @map("tenant_id") @db.Uuid
  kind               SurveyKind
  name               String
  questions          Json       @default("[]")
  scheduledDaysAfter Int?       @map("scheduled_days_after") // eficacia diferida
  active             Boolean    @default(true)
  version            Int        @default(1)

  responses SurveyResponse[]
  contents  ActivityContent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("survey_templates")
}

model SurveyResponse {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  surveyTemplateId     String         @map("survey_template_id") @db.Uuid
  surveyTemplate       SurveyTemplate @relation(fields: [surveyTemplateId], references: [id])
  templateVersion      Int            @map("template_version")
  enrollmentId         String         @map("enrollment_id") @db.Uuid
  respondentUserId     String         @map("respondent_user_id") @db.Uuid // participante o JEFE (eficacia)
  answers              Json           @default("{}")
  result               SurveyResult?
  followUpAssignmentId String?        @map("follow_up_assignment_id") @db.Uuid // refuerzo si eficacia negativa
  respondedAt          DateTime       @default(now()) @map("responded_at")

  @@map("survey_responses")
}

model EfficacySchedule {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  enrollmentId    String         @map("enrollment_id") @db.Uuid
  dueAt           DateTime       @map("due_at")
  evaluatorUserId String         @map("evaluator_user_id") @db.Uuid // el jefe
  status          EfficacyStatus @default(PENDING)
  createdAt       DateTime       @default(now()) @map("created_at")

  @@map("efficacy_schedules")
}

// ──────────────────── 6.11 Certificacion y certificados ────────────────────

model Certification {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  name              String
  code              String
  awardedByType     PathItemType @map("awarded_by_type") // ACTIVITY | PATH
  awardedById       String       @map("awarded_by_id") @db.Uuid
  renewalTargetId   String?      @map("renewal_target_id") @db.Uuid // actividad de renovacion (puede ser distinta)
  validityMonths    Int?         @map("validity_months")
  fixedExpiryRule   Json?        @map("fixed_expiry_rule") // {month, day} — anclaje por fecha fija anual
  renewalWindowDays Int          @default(60) @map("renewal_window_days")
  active            Boolean      @default(true)

  grants CertificationGrant[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("certifications")
}

// UNA FILA POR RONDA, inmutable (Decision #13).
model CertificationGrant {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  certificationId    String        @map("certification_id") @db.Uuid
  certification      Certification @relation(fields: [certificationId], references: [id])
  userId             String        @map("user_id") @db.Uuid
  cycleNumber        Int           @map("cycle_number")
  grantedAt          DateTime      @default(now()) @map("granted_at")
  validUntil         DateTime?     @map("valid_until")
  status             GrantStatus   @default(ACTIVE) // por vencer/vencido se CALCULAN de valid_until
  sourceEnrollmentId String        @map("source_enrollment_id") @db.Uuid

  certificates Certificate[]

  @@unique([certificationId, userId, cycleNumber])
  @@index([tenantId, userId, status])
  @@index([tenantId, validUntil])
  @@map("certification_grants")
}

model CertificateTemplate {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @map("tenant_id") @db.Uuid
  name          String
  versionNumber Int     @default(1) @map("version_number")
  /// EL ARTE que subio el cliente. Nulo mientras no lo suba; sin el no se puede activar.
  backgroundKey String? @map("background_key")
  /// Casi todas las constancias son horizontales, pero no todas.
  landscape     Boolean @default(true)
  /// DONDE VA CADA CAMPO, en PORCENTAJE de la hoja y con origen arriba-izquierda (Decision #112).
  /// Ver `certificate-layout.ts`. En porcentaje porque el arte puede venir a cualquier resolucion.
  fields        Json    @default("{}")
  /// Las firmas: [{name, title, imageKey}]. PNG con fondo transparente.
  signers       Json    @default("[]")
  active        Boolean @default(true)

  certificates Certificate[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("certificate_templates")
}

// El registro; el PDF es artefacto congelado (Decision #14).
model Certificate {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  enrollmentId     String?             @map("enrollment_id") @db.Uuid
  grantId          String?             @map("grant_id") @db.Uuid
  grant            CertificationGrant? @relation(fields: [grantId], references: [id])
  serialNumber     String              @map("serial_number") // CERT-2026-000123 (serie tenant/ano)
  verificationCode String              @unique @map("verification_code") // aleatorio, NO adivinable
  templateId       String              @map("template_id") @db.Uuid
  template         CertificateTemplate @relation(fields: [templateId], references: [id])
  templateVersion  Int                 @map("template_version")
  renderSnapshot   Json                @map("render_snapshot") // todos los datos por VALOR
  pdfStorageKey    String?             @map("pdf_storage_key")
  issuedAt         DateTime            @default(now()) @map("issued_at")
  validUntil       DateTime?           @map("valid_until")
  revokedAt        DateTime?           @map("revoked_at")
  revokedBy        String?             @map("revoked_by") @db.Uuid
  revokedReason    String?             @map("revoked_reason")

  @@unique([tenantId, serialNumber])
  @@index([tenantId, userId, issuedAt])
  /// UNA POR EJECUCION: `UNIQUE(tenant_id, enrollment_id) WHERE enrollment_id IS NOT NULL`. Es un
  /// indice PARCIAL —hay constancias sin inscripcion, las que nacen de una certificacion otorgada—
  /// y Prisma no sabe expresarlos, asi que vive en la migracion `20260901220000_certificados`.
  /// No quitarlo: sin el, dos evaluaciones de completado a la vez emiten dos constancias.
  @@map("certificates")
}

// Numeracion por serie tenant/ano con row-lock (FOR UPDATE).
model SequenceCounter {
  tenantId   String @map("tenant_id") @db.Uuid
  entityType String @map("entity_type") // CERTIFICATE | OFFERING | PLAN | ...
  year       Int
  lastValue  BigInt @default(0) @map("last_value")

  @@id([tenantId, entityType, year])
  @@map("sequence_counters")
}

// ──────────────── 6.12 Engagement: repeticion espaciada, racha, puntos ────────────────

// Motor determinista 2-7-14-30 tipo Leitner (Decision #22).
model ReviewQueueItem {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  questionVersionId  String   @map("question_version_id") @db.Uuid
  sourceEnrollmentId String   @map("source_enrollment_id") @db.Uuid
  stage              Int      @default(0) // 0..4
  dueAt              DateTime @map("due_at")
  lapses             Int      @default(0)
  lastResult         String?  @map("last_result") // PASS | FAIL
  retired            Boolean  @default(false) // dominada (test out)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([userId, questionVersionId])
  @@index([tenantId, userId, dueAt, retired])
  @@map("review_queue")
}

// PRIVADA: solo la ve el usuario (Decision #23). Unidad = leccion completada.
model UserStreak {
  userId           String    @id @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId         String    @map("tenant_id") @db.Uuid
  currentStreak    Int       @default(0) @map("current_streak")
  longestStreak    Int       @default(0) @map("longest_streak")
  lastActivityDate DateTime? @map("last_activity_date") @db.Date
  freezesAvailable Int       @default(2) @map("freezes_available")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("user_streaks")
}

model PointsLedgerEntry {
  id         BigInt   @id @default(autoincrement())
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  points     Int
  reasonCode String   @map("reason_code")
  refType    String?  @map("ref_type")
  refId      String?  @map("ref_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId, userId])
  @@map("points_ledger")
}

// ──────────────── 6.13 Aprobaciones (flujo Analista) e IA ────────────────

model ApprovalRequest {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  requestedBy   String         @map("requested_by") @db.Uuid
  entityType    String         @map("entity_type")
  entityId      String         @map("entity_id") @db.Uuid
  action        ApprovalAction
  payload       Json // el cambio propuesto; se APLICA solo al aprobar
  justification String
  status        ApprovalStatus @default(PENDING)
  decidedBy     String?        @map("decided_by") @db.Uuid
  decidedAt     DateTime?      @map("decided_at")
  decisionNote  String?        @map("decision_note")
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@map("approval_requests")
}

model AiGenerationJob {
  id                String      @id @default(uuid()) @db.Uuid
  tenantId          String      @map("tenant_id") @db.Uuid
  sourceDocumentKey String      @map("source_document_key")
  target            AiJobTarget
  status            AiJobStatus @default(QUEUED)
  draft             Json? // tarjetas/preguntas propuestas; NUNCA se publica sin revision (Decision #24)
  requestedBy       String      @map("requested_by") @db.Uuid
  reviewedBy        String?     @map("reviewed_by") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@map("ai_generation_jobs")
}

// ──────────────────── 6.14 Transversales ────────────────────

model StoredDocument {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id") @db.Uuid
  storageKey   String   @map("storage_key")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  uploadedBy   String   @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, entityType, entityId])
  @@map("documents")
}

// Outbox transaccional: PENDING se escribe en la MISMA transaccion del cambio de dominio.
model Notification {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  eventType       String              @map("event_type")
  channel         NotificationChannel
  recipientUserId String?             @map("recipient_user_id") @db.Uuid
  recipientEmail  String?             @map("recipient_email")
  status          NotificationStatus  @default(PENDING)
  subject         String?
  body            String?
  referenceType   String?             @map("reference_type")
  referenceId     String?             @map("reference_id") @db.Uuid
  sentAt          DateTime?           @map("sent_at")
  readAt          DateTime?           @map("read_at")
  failedReason    String?             @map("failed_reason")
  retryCount      Int                 @default(0) @map("retry_count")
  createdAt       DateTime            @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@index([tenantId, recipientUserId, readAt])
  @@map("notifications")
}

model NotificationTemplate {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  eventType       String              @map("event_type")
  channel         NotificationChannel
  subjectTemplate String              @map("subject_template")
  bodyTemplate    String              @map("body_template")
  active          Boolean             @default(true)

  @@unique([tenantId, eventType, channel])
  @@map("notification_templates")
}

// Inmutable: nunca se actualiza ni borra (hasta politica de retencion).
model AuditLog {
  id           BigInt   @id @default(autoincrement())
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  oldValues    Json?    @map("old_values")
  newValues    Json?    @map("new_values")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, userId, createdAt])
  @@map("audit_logs")
}

// SST_TRAINING: 20 anos desde users.terminated_at (D1072 art. 2.2.4.6.13). ANONYMIZE selectivo:
// se scrubea PII de contacto pero el REGISTRO formativo se PRESERVA por mandato legal (Decision #16).
model RetentionPolicy {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  recordClass    RecordClass     @map("record_class")
  retentionYears Int             @map("retention_years")
  legalBasis     String          @map("legal_basis")
  actionOnExpiry RetentionAction @map("action_on_expiry")
  active         Boolean         @default(true)

  @@unique([tenantId, recordClass])
  @@map("retention_policies")
}

// ─────────────────────────── CAPA DE PLATAFORMA (Decision #100) ───────────────────────────
//
// Quien OPERA el producto, no quien lo usa. Ninguna de estas tres tablas tiene `tenantId` ni
// politica de aislamiento: no pertenecen a ninguna empresa, asi que no hay nada de un cliente que
// proteger de otro. Lo que las protege es que solo se llega con un token de plataforma, emitido
// en su propio ingreso (`/v1/platform/auth/login`), que no es el mismo que el de los tenants.

/// Cuenta del proveedor. Vive FUERA de los tenants a proposito: si viviera dentro de uno, el dia
/// que ese cliente se desactive se perderia el acceso a la administracion de todos los demas.
model PlatformUser {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  fullName            String    @map("full_name")
  passwordHash        String    @map("password_hash")
  active              Boolean   @default(true)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  sessions PlatformSession[]

  @@map("platform_users")
}

/// Misma mecanica que `UserSession` (Decision #91): varias sesiones a la vez, token rotado y
/// ventana de gracia para que dos pestanas que refrescan a la vez no se tumben entre si.
model PlatformSession {
  id             String       @id @default(uuid()) @db.Uuid
  platformUserId String       @map("platform_user_id") @db.Uuid
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)

  tokenHash          String    @map("token_hash")
  previousHash       String?   @map("previous_hash")
  previousValidUntil DateTime? @map("previous_valid_until")

  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  @@index([platformUserId, expiresAt])
  @@index([tokenHash])
  @@map("platform_sessions")
}

/// UNA SOLA FILA (`id` fijo en 1, con CHECK en la base de datos). De este dato solo puede haber
/// uno: con dos filas habria dos verdades sobre el contacto del proveedor y la lectura decidiria
/// cual gana por orden de insercion.
model PlatformSettings {
  id           Int      @id @default(1)
  supportName  String   @default("") @map("support_name")
  supportEmail String   @default("") @map("support_email")
  supportPhone String   @default("") @map("support_phone")
  supportNote  String   @default("") @map("support_note")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ─────────────────────────────────────────────────────────────────────────────────────────────
// EVALUACION DE DESEMPENO (Decision #134). Ver docs/modulos/desempeno.md.
//
// NO COMPARTE MOTOR CON LOS EXAMENES, y es la decision de fondo del modulo. Un examen lo responde
// el dueno de la nota; una evaluacion de desempeno la responde OTRA persona. Todo el motor de
// examenes vive sobre `enrollments` y `attempts` —intentos, bloqueo, nota minima, recalificacion—
// y encajar el desempeno ahi obligaria a inventar una inscripcion falsa por persona evaluada. Esa
// inscripcion entraria en las metricas de formacion, que es exactamente lo que el cliente
// prohibio: "no deben afectar ni mezclarse con capacitaciones o inducciones".
//
// REGLA QUE NO SE ROMPE: nada de aqui escribe en `enrollments`, `assignments` ni
// `certification_grants`. Si algun dia alimenta el plan del ano siguiente, sera generando una
// NECESIDAD de formacion, nunca tocando el cumplimiento.
// ─────────────────────────────────────────────────────────────────────────────────────────────

/// La escala con la que se califica una competencia. Vive en la COMPETENCIA y no en la respuesta:
/// es lo que permite tener "1 a 5" y "cumple / no cumple" en el mismo formulario sin columnas
/// nulas por todas partes.
enum PerformanceScale {
  ONE_TO_FIVE
  ONE_TO_TEN
  YES_NO
  /// Sin escala: solo texto. Para "logros del ano" o "plan de mejora".
  TEXT_ONLY
}

enum PerformanceCycleStatus {
  DRAFT
  OPEN
  CLOSED
}

/// Quien califica. Una FILA POR EVALUADOR y no una fila con dos columnas: anadir pares o el jefe
/// del jefe seria un valor mas en este enum, no una migracion de la tabla.
enum PerformanceReviewerRole {
  SELF
  MANAGER
}

enum PerformanceReviewStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
}

/// QUE se evalua. Catalogo del tenant, editable desde la interfaz: es lo que hace el modulo
/// "muy parametrizable" sin tocar codigo, que fue el pedido literal del cliente.
model PerformanceCompetency {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  code         String
  name         String
  description  String?
  scale        PerformanceScale @default(ONE_TO_FIVE)
  active       Boolean          @default(true)
  displayOrder Int              @default(0) @map("display_order")

  /// QUE FORMACION FORTALECE ESTA COMPETENCIA. Es la costura hacia el plan del ano siguiente: la
  /// idea del cliente es que una calificacion baja se convierta en una necesidad de formacion, y
  /// para eso hace falta saber QUE formacion la cubre.
  ///
  /// Se anade ahora y no cuando se construya ese puente: es una columna anulable hoy, y despues
  /// seria una migracion mas volver a pedirle al cliente que rellene el catalogo entero.
  ///
  /// HOY NO LA LEE NADIE. Apuntar no es exigir: nada la convierte en obligacion automaticamente,
  /// porque decidir a quien se forma el ano que viene es una decision de personas, no un disparo
  /// del sistema.
  suggestedActivityId String?   @map("suggested_activity_id") @db.Uuid
  suggestedActivity   Activity? @relation(fields: [suggestedActivityId], references: [id])

  items PerformanceFormItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("performance_competencies")
}

/// El formulario: que competencias se preguntan y con que peso. Puede acotarse a unos cargos
/// —lo que se le pregunta a un conductor no es lo que se le pregunta a un analista— y sin cargos
/// aplica a toda la empresa.
model PerformanceForm {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  name        String
  description String?
  active      Boolean @default(true)

  /// DE QUE FORMULARIO HEREDA LAS COMPETENCIAS COMUNES (Decision #141).
  ///
  /// Las dos capas que usa todo el sector: unas competencias ORGANIZACIONALES iguales para todos
  /// —seguridad, trabajo en equipo, los valores— y unas DEL CARGO. Sin esto, las comunes hay que
  /// repetirlas dentro de cada formulario de cargo: con cinco cargos da igual, con cuarenta,
  /// cambiar una obliga a editar cuarenta formularios y el que se olvide se evalua distinto sin
  /// que nadie lo note.
  ///
  /// SE HEREDA UN SOLO NIVEL, a proposito. Una cadena de plantillas heredando de plantillas es
  /// imposible de leer en pantalla y de explicar a quien la configura una vez al ano: al elegir
  /// base solo se ofrecen formularios que no heredan de nadie.
  ///
  /// Lo que NO cambia: cada persona sigue respondiendo UN formulario, con UNA evaluacion y UNA
  /// nota. Al abrir el ciclo la copia congelada junta las dos listas —primero las comunes, despues
  /// las del cargo— y a partir de ahi el modulo entero funciona igual que antes.
  baseFormId String?           @map("base_form_id") @db.Uuid
  base       PerformanceForm?  @relation("FormBase", fields: [baseFormId], references: [id])
  derivados  PerformanceForm[] @relation("FormBase")

  items      PerformanceFormItem[]
  jobTitles  PerformanceFormJobTitle[]
  cycleForms PerformanceCycleForm[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, active])
  @@map("performance_forms")
}

model PerformanceFormItem {
  id           String                @id @default(uuid()) @db.Uuid
  tenantId     String                @map("tenant_id") @db.Uuid
  formId       String                @map("form_id") @db.Uuid
  form         PerformanceForm       @relation(fields: [formId], references: [id], onDelete: Cascade)
  competencyId String                @map("competency_id") @db.Uuid
  competency   PerformanceCompetency @relation(fields: [competencyId], references: [id])
  /// Peso relativo dentro del formulario. Con todos a 1 es un promedio simple.
  weight       Int                   @default(1)
  displayOrder Int                   @default(0) @map("display_order")

  @@unique([formId, competencyId])
  @@index([tenantId])
  @@map("performance_form_items")
}

model PerformanceFormJobTitle {
  id         String          @id @default(uuid()) @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  formId     String          @map("form_id") @db.Uuid
  form       PerformanceForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  jobTitleId String          @map("job_title_id") @db.Uuid
  jobTitle   JobTitle        @relation(fields: [jobTitleId], references: [id])

  @@unique([formId, jobTitleId])
  @@index([tenantId])
  @@map("performance_form_job_titles")
}

/// LA CAMPANA: "Desempeno 2026", con sus fechas y sus reglas. Sin ciclo no existe el "cada ano"
/// que pidio el cliente.
model PerformanceCycle {
  id       String                 @id @default(uuid()) @db.Uuid
  tenantId String                 @map("tenant_id") @db.Uuid
  name     String
  startsAt DateTime               @map("starts_at")
  endsAt   DateTime               @map("ends_at")
  status   PerformanceCycleStatus @default(DRAFT)

  /// Si la persona se autoevalua ademas de que la califique su jefe. Es lo que sostiene la
  /// conversacion; se deja configurable porque no todas las empresas lo hacen.
  selfEvaluation    Boolean @default(true) @map("self_evaluation")
  /// Si la persona ve el resultado de su jefe.
  visibleToEmployee Boolean @default(true) @map("visible_to_employee")
  /// Si la persona tiene que firmar que la conversacion ocurrio. Es lo que lo vuelve evidencia.
  requiresSignature Boolean @default(true) @map("requires_signature")

  /// LOS FORMULARIOS DE LA CAMPANA (Decision #139). Varios, no uno: el de conductores y el de
  /// analistas son la MISMA campana, y obligar a abrir un ciclo por cada uno partia el consolidado
  /// en dos y obligaba a sumar a mano. Cada uno lleva su propia copia congelada.
  forms PerformanceCycleForm[]

  openedAt DateTime? @map("opened_at")
  closedAt DateTime? @map("closed_at")

  reviews PerformanceReview[]

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, status])
  @@map("performance_cycles")
}

/// UN FORMULARIO DENTRO DE UNA CAMPANA, con su copia congelada (Decision #139).
///
/// La copia vive AQUI y no en el ciclo porque en la misma campana conviven varias: si el conductor
/// responde el formulario de conductores y el analista el suyo, guardar una sola copia por ciclo
/// obligaria a adivinar cual le tocaba a cada quien al leer una evaluacion de hace tres anos.
///
/// El REPARTO sale de los cargos que ya declara cada formulario (`performance_form_job_titles`):
/// el que no declara ninguno es el general, y recoge a quien no encaje en ningun otro.
model PerformanceCycleForm {
  id       String           @id @default(uuid()) @db.Uuid
  tenantId String           @map("tenant_id") @db.Uuid
  cycleId  String           @map("cycle_id") @db.Uuid
  cycle    PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  formId   String           @map("form_id") @db.Uuid
  form     PerformanceForm  @relation(fields: [formId], references: [id])

  /// Lo que se pregunto en ESTE ciclo con ESTE formulario. Se escribe al abrir.
  formSnapshot Json? @map("form_snapshot")

  displayOrder Int @default(0) @map("display_order")

  reviews PerformanceReview[]

  createdAt DateTime @default(now()) @map("created_at")

  /// El mismo formulario dos veces en la misma campana no significa nada.
  @@unique([cycleId, formId])
  @@index([tenantId])
  @@map("performance_cycle_forms")
}

/// UNA evaluacion: un ciclo, una persona evaluada y UN evaluador. Si hay autoevaluacion, la misma
/// persona tiene dos filas —la suya y la de su jefe— y por eso se pueden comparar lado a lado.
model PerformanceReview {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @map("tenant_id") @db.Uuid
  cycleId         String                  @map("cycle_id") @db.Uuid
  cycle           PerformanceCycle        @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  /// CON QUE FORMULARIO se evalua a esta persona. Dos personas del mismo ciclo pueden responder
  /// formularios distintos, asi que la copia congelada se lee por aqui y no por el ciclo.
  cycleFormId     String                  @map("cycle_form_id") @db.Uuid
  cycleForm       PerformanceCycleForm    @relation(fields: [cycleFormId], references: [id], onDelete: Cascade)
  /// A quien se evalua.
  subjectUserId   String                  @map("subject_user_id") @db.Uuid
  /// Quien califica. En SELF es la misma persona.
  evaluatorUserId String                  @map("evaluator_user_id") @db.Uuid
  reviewerRole    PerformanceReviewerRole @map("reviewer_role")
  status          PerformanceReviewStatus @default(PENDING)

  /// Promedio ponderado de las respuestas con escala. `null` mientras no se haya entregado o si el
  /// formulario era solo texto.
  score       Decimal?  @db.Decimal(4, 2)
  comment     String?
  submittedAt DateTime? @map("submitted_at")

  /// Cuando la persona reconocio que la conversacion ocurrio. No es "estoy de acuerdo".
  signedAt DateTime? @map("signed_at")
  signedIp String?   @map("signed_ip")

  answers PerformanceAnswer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Una sola evaluacion por ciclo, persona y rol del evaluador.
  @@unique([cycleId, subjectUserId, reviewerRole])
  @@index([tenantId, evaluatorUserId, status])
  @@index([tenantId, subjectUserId])
  @@map("performance_reviews")
}

model PerformanceAnswer {
  id             String            @id @default(uuid()) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  reviewId       String            @map("review_id") @db.Uuid
  review         PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  /// Se guarda el ID y TAMBIEN el nombre: la competencia puede renombrarse o desactivarse despues,
  /// y lo que se respondio tiene que poder leerse dentro de cinco anos tal como se pregunto.
  competencyId   String            @map("competency_id") @db.Uuid
  competencyName String            @map("competency_name")
  /// El valor numerico de la escala. `null` en las competencias de solo texto.
  value          Int?
  comment        String?

  @@unique([reviewId, competencyId])
  @@index([tenantId])
  @@map("performance_answers")
}
