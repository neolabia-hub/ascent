// ──────────────────────── 6.1 Plataforma y tenants ────────────────────────

model Tenant {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  slug     String  @unique // subdominio: transprensa.neopulse.app (Decision #32)
  nit      String?
  timezone String  @default("America/Bogota")
  plan     String  @default("pilot")
  active   Boolean @default(true)
  branding Json    @default("{}") // validado con tenantBrandingSchema (Zod)
  settings Json    @default("{}") // validado con tenantSettingsSchema (Zod)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenants")
}

// ──────────────────────── 6.2 Organizacion (catalogos) ────────────────────────

model Area {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  code     String
  parentId String? @map("parent_id") @db.Uuid
  parent   Area?   @relation("AreaTree", fields: [parentId], references: [id])

  /// QUIEN DIRIGE EL AREA (Decision #115). Es quien responde la encuesta de EFICACIA sobre su
  /// gente: el unico que puede decir si lo aprendido se aplica en el puesto.
  ///
  /// Nulo es un estado normal y tiene consecuencia visible: esa gente no recibe encuesta de
  /// eficacia. Es mejor que inventar un evaluador que no ha visto trabajar a nadie.
  responsibleUserId String? @map("responsible_user_id") @db.Uuid
  responsible       User?   @relation("AreasQueDirige", fields: [responsibleUserId], references: [id])
  children          Area[]  @relation("AreaTree")

  active       Boolean @default(true)
  displayOrder Int     @default(0) @map("display_order")

  users         User[]
  processes     Process[]
  analystScopes AnalystScope[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("areas")
}

model Process {
  id                String  @id @default(uuid()) @db.Uuid
  tenantId          String  @map("tenant_id") @db.Uuid
  name              String
  code              String // SGI | SST | PESV | SARLAFT | ...
  responsibleUserId String? @map("responsible_user_id") @db.Uuid
  responsible       User?   @relation("ProcesosQueLidera", fields: [responsibleUserId], references: [id])
  areaId            String? @map("area_id") @db.Uuid
  area              Area?   @relation(fields: [areaId], references: [id])
  active            Boolean @default(true)
  displayOrder      Int     @default(0) @map("display_order")

  activities    Activity[]
  analystScopes AnalystScope[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("processes")
}

model JobTitleType {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  name         String // Administrativo | Operativo | Comercial
  code         String
  active       Boolean @default(true)
  displayOrder Int     @default(0) @map("display_order")

  jobTitles JobTitle[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("job_title_types")
}

model JobTitle {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  name           String
  code           String
  jobTitleTypeId String       @map("job_title_type_id") @db.Uuid
  jobTitleType   JobTitleType @relation(fields: [jobTitleTypeId], references: [id])
  active         Boolean      @default(true)
  displayOrder   Int          @default(0) @map("display_order")

  users             User[]
  activityJobTitles ActivityJobTitle[]
  performanceForms  PerformanceFormJobTitle[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("job_titles")
}

model Service {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  name         String // Almacenamiento | Masivo | Paqueteo
  code         String
  active       Boolean @default(true)
  displayOrder Int     @default(0) @map("display_order")

  activityServices ActivityService[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  users     User[]

  @@unique([tenantId, code])
  @@map("services")
}

model Regional {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  name         String
  code         String
  active       Boolean @default(true)
  displayOrder Int     @default(0) @map("display_order")

  users             User[]
  offerings         Offering[]
  activityRegionals ActivityRegional[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("regionals")
}

model Norm {
  id                  String  @id @default(uuid()) @db.Uuid
  tenantId            String  @map("tenant_id") @db.Uuid
  name                String // BASC | Res. 2674/2013 BPM-HACCP | Trinorma | RES-PESV | N/A
  code                String
  annualHoursRequired Int?    @map("annual_hours_required") // BPM: 10 h/ano por manipulador
  active              Boolean @default(true)
  displayOrder        Int     @default(0) @map("display_order")

  activityNorms ActivityNorm[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("norms")
}

// ──────────────────────── 6.3 Usuarios y acceso ────────────────────────

model User {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  documentType   DocumentType @default(CEDULA) @map("document_type")
  documentNumber String       @map("document_number")
  fullName       String       @map("full_name")
  phone          String?
  email          String
  emailKind      EmailKind    @default(PERSONAL) @map("email_kind")
  /// Foto de perfil, subida por la propia persona. Nulable siempre: sin ella van las iniciales.
  avatarKey      String?      @map("avatar_key")

  passwordHash        String        @map("password_hash")
  mustChangePassword  Boolean       @default(true) @map("must_change_password")
  failedLoginAttempts Int           @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?     @map("locked_until")
  lastLogin           DateTime?     @map("last_login")
  /// OBSOLETA (Decision #91): las sesiones viven en `user_sessions`. Se conserva la columna para
  /// no romper la migracion; deja de escribirse y de leerse.
  refreshTokenHash    String?       @map("refresh_token_hash")
  sessions            UserSession[]

  jobTitleId     String    @map("job_title_id") @db.Uuid
  jobTitle       JobTitle  @relation(fields: [jobTitleId], references: [id])
  areaId         String    @map("area_id") @db.Uuid
  area           Area      @relation(fields: [areaId], references: [id])
  /// Las areas que DIRIGE (distinto de la suya): a quien evalua en las encuestas de eficacia.
  areasQueDirige Area[]    @relation("AreasQueDirige")
  regionalId     String?   @map("regional_id") @db.Uuid
  // Linea de servicio a la que pertenece (almacenamiento, masivo, paqueteo). OPCIONAL: hay
  // empresas que no organizan asi a su gente, y exigirlo bloquearia su carga masiva entera.
  serviceId      String?   @map("service_id") @db.Uuid
  service        Service?  @relation(fields: [serviceId], references: [id])
  regional       Regional? @relation(fields: [regionalId], references: [id])

  birthDate      DateTime?      @map("birth_date") @db.Date // felicitaciones, indicadores por edad
  hiredAt        DateTime?      @map("hired_at") @db.Date // dispara induccion PREVIA al inicio (D1072)
  employmentType EmploymentType @default(DIRECTO) @map("employment_type")
  roadActor      RoadActor?     @map("road_actor") // PESV Paso 10
  terminatedAt   DateTime?      @map("terminated_at") @db.Date // ancla de retencion 20 anos (SST)

  // Aceptaciones legales en la activacion de la cuenta.
  habeasDataConsentAt   DateTime? @map("habeas_data_consent_at")
  habeasDataVersion     String?   @map("habeas_data_version")
  esignAgreementAt      DateTime? @map("esign_agreement_accepted_at")
  esignAgreementVersion String?   @map("esign_agreement_version")

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  active    Boolean   @default(true)
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  overrides       UserPermissionOverride[]
  analystScopes   AnalystScope[]
  enrollments     Enrollment[]
  assignments     Assignment[]
  attempts        Attempt[]
  audienceMembers AudienceMember[]
  processesLed    Process[]                @relation("ProcesosQueLidera")
  versionsLed     ActivityVersion[]        @relation("VersionesQueResponde")
  streak          UserStreak?

  @@unique([tenantId, documentNumber])
  @@unique([tenantId, email])
  @@index([tenantId, active, fullName])
  // Lo creo la migracion `user_service` y nunca se declaro aqui: sin esta linea, la siguiente
  // migracion generada lo BORRA. Lo usa el filtro de audiencias por linea de servicio.
  @@index([tenantId, serviceId])
  @@index([tenantId, areaId])
  @@map("users")
}

model Role {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  code     String // ADMIN | ANALISTA | USUARIO (seed; el tenant puede crear mas)
  isSystem Boolean @default(false) @map("is_system")
  active   Boolean @default(true)

  permissions RolePermission[]
  users       User[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("roles")
}

// Catalogo GLOBAL de permisos (sin tenant_id -> sin RLS; legible por todos).
model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique
  category    String
  description String

  rolePermissions RolePermission[]
  overrides       UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  // tenant_id duplicado para RLS (la PK ya aisla via role, pero RLS exige la columna).
  tenantId     String     @map("tenant_id") @db.Uuid

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermissionOverride {
  userId       String     @map("user_id") @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  tenantId     String     @map("tenant_id") @db.Uuid
  granted      Boolean // true = permiso extra; false = revocar el del rol
  setBy        String     @map("set_by") @db.Uuid
  setAt        DateTime   @default(now()) @map("set_at")

  @@id([userId, permissionId])
  @@map("user_permission_overrides")
}

// Ambito del Analista: que procesos/areas gestiona.
model AnalystScope {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  processId String?  @map("process_id") @db.Uuid
  process   Process? @relation(fields: [processId], references: [id])
  areaId    String?  @map("area_id") @db.Uuid
  area      Area?    @relation(fields: [areaId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@map("analyst_scopes")
}

model UserImportBatch {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  filename   String
  storageKey String?           @map("storage_key")
  status     ImportBatchStatus @default(PROCESSING)
  totalRows  Int               @default(0) @map("total_rows")
  okRows     Int               @default(0) @map("ok_rows")
  failedRows Int               @default(0) @map("failed_rows")
  createdBy  String            @map("created_by") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at")

  rows UserImportRow[]

  @@map("user_import_batches")
}

model UserImportRow {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  batchId     String          @map("batch_id") @db.Uuid
  batch       UserImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber   Int             @map("row_number")
  raw         Json
  status      ImportRowStatus
  errorDetail String?         @map("error_detail")
  userId      String?         @map("user_id") @db.Uuid

  @@map("user_import_rows")
}

// ──────────────────────── 6.4 Catalogo formativo ────────────────────────

model ActivityType {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  name         String // Induccion general | Induccion especifica | Reinduccion | Plan | Extraordinaria | Pildora
  code         String // INDUCCION_GENERAL | INDUCCION_ESPECIFICA | REINDUCCION | PLAN | EXTRA | MICROLEARNING
  icon         String?
  colorHex     String? @map("color_hex")
  isSystem     Boolean @default(false) @map("is_system")
  active       Boolean @default(true)
  displayOrder Int     @default(0) @map("display_order")
  // requires_assessment, requires_survey, requires_efficacy, issues_certificate,
  // default_assignment_mode, default_recurrence_months, is_micro, participates_in_plan,
  // requires_before_hire
  config       Json    @default("{}")

  activities Activity[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("activity_types")
}

model Activity {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  code              String
  name              String
  description       String?
  activityTypeId    String       @map("activity_type_id") @db.Uuid
  activityType      ActivityType @relation(fields: [activityTypeId], references: [id])
  processId         String       @map("process_id") @db.Uuid
  process           Process      @relation(fields: [processId], references: [id])
  responsibleUserId String?      @map("responsible_user_id") @db.Uuid
  modality          Modality     @default(VIRTUAL) // default; la convocatoria puede precisar
  currentVersionId  String?      @unique @map("current_version_id") @db.Uuid
  tags              String[]     @default([])

  /// PORTADA de la formacion (Decision #88): la clave del archivo en el almacen, firmada al
  /// servirla. Vive en la ACTIVIDAD y no en su version, por lo mismo que `presentation` en una
  /// evaluacion: una foto no es evidencia —no cambia que se enseno ni como se califico— asi que
  /// cambiarla no puede costar una version nueva de la formacion.
  ///
  /// NULL es un estado NORMAL, no un hueco: sin foto se pinta una portada generada a partir del
  /// id y del tipo (ver `cover.tsx`). Exigirla dejaria media biblioteca en gris el primer dia, y
  /// bloquear la publicacion de una capacitacion obligatoria por una foto seria absurdo.
  coverKey String? @map("cover_key")

  /// ¿ESTA FORMACION ENTREGA CONSTANCIA? (Decision #110). Editable aqui y CONGELADO al publicar en
  /// `ActivityVersion.issuesCertificate`: desmarcarlo manana no puede dejar sin explicacion las
  /// constancias ya emitidas.
  ///
  /// TRES ESTADOS (Decision #111): `null` HEREDA del tipo —el caso normal—, `true` fuerza que si y
  /// `false` fuerza que no. La pregunta es por CLASE de formacion, no por formacion: una pildora
  /// no acredita y una induccion si, y eso no cambia entre las doscientas de una empresa. Lo que
  /// hay que marcar doscientas veces se olvida.
  issuesCertificate Boolean? @map("issues_certificate")

  /// Horas que acredita el papel. Es el numero que el auditor SUMA por persona y por tema, asi que
  /// no es lo mismo que `estimatedMinutes` —lo que se tarda en cursarla— y por eso es un campo
  /// aparte: una capacitacion presencial de 8 horas puede tener 20 minutos de contenido virtual.
  certificateHours Int? @map("certificate_hours")

  /// ¿SE MIDE LA EFICACIA de esta formacion? (Decision #118)
  ///
  /// Tres estados como la constancia: `null` hereda del tipo, `true`/`false` deciden.
  ///
  /// A diferencia de la satisfaccion —que se quiere de TODO lo que se dicte, y por eso va por
  /// tipo— la eficacia depende de la naturaleza de la formacion concreta: en alturas importa si
  /// usa el arnes como le ensenaron; en una actualizacion documental, preguntarle al jefe a los 30
  /// dias si "aplica" no significa nada. Dentro de un mismo tipo conviven las dos.
  requiresEfficacy Boolean? @map("requires_efficacy")

  versions    ActivityVersion[]       @relation("ActivityVersions")
  norms       ActivityNorm[]
  services    ActivityService[]
  /// Competencias de desempeno que esta formacion fortalece (solo un puntero; ver PerformanceCompetency).
  strengthens PerformanceCompetency[]
  regionals   ActivityRegional[]
  jobTitles   ActivityJobTitle[]

  active    Boolean   @default(true)
  version   Int       @default(1) // optimistic lock
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, code])
  @@index([tenantId, active, updatedAt])
  @@index([tenantId, activityTypeId])
  @@index([tenantId, processId])
  @@map("activities")
}

model ActivityNorm {
  activityId String   @map("activity_id") @db.Uuid
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  normId     String   @map("norm_id") @db.Uuid
  norm       Norm     @relation(fields: [normId], references: [id], onDelete: Cascade)
  tenantId   String   @map("tenant_id") @db.Uuid

  @@id([activityId, normId])
  @@map("activity_norms")
}

model ActivityService {
  activityId String   @map("activity_id") @db.Uuid
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  serviceId  String   @map("service_id") @db.Uuid
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  tenantId   String   @map("tenant_id") @db.Uuid

  @@id([activityId, serviceId])
  @@map("activity_services")
}

model ActivityRegional {
  activityId String   @map("activity_id") @db.Uuid
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  regionalId String   @map("regional_id") @db.Uuid
  regional   Regional @relation(fields: [regionalId], references: [id], onDelete: Cascade)
  tenantId   String   @map("tenant_id") @db.Uuid

  @@id([activityId, regionalId])
  @@map("activity_regionals")
}

model ActivityJobTitle {
  activityId String   @map("activity_id") @db.Uuid
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  jobTitleId String   @map("job_title_id") @db.Uuid
  jobTitle   JobTitle @relation(fields: [jobTitleId], references: [id], onDelete: Cascade)
  tenantId   String   @map("tenant_id") @db.Uuid

  @@id([activityId, jobTitleId])
  @@map("activity_job_titles")
}

// INMUTABLE al publicar (copy-on-publish, Decision #6).
model ActivityVersion {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  activityId    String        @map("activity_id") @db.Uuid
  activity      Activity      @relation("ActivityVersions", fields: [activityId], references: [id])
  versionNumber Int           @map("version_number")
  status        VersionStatus @default(DRAFT)
  publishedAt   DateTime?     @map("published_at")
  publishedBy   String?       @map("published_by") @db.Uuid

  // SNAPSHOT resuelto de la cascada (tenant -> actividad) al publicar (Decision #27).
  // Incluye QUIEN RESPONDIA por la formacion cuando se publico (Decision #64): la constancia y el
  // auditor preguntan por el de entonces, no por el de hoy.
  responsibleUserId  String?         @map("responsible_user_id") @db.Uuid
  responsible        User?           @relation("VersionesQueResponde", fields: [responsibleUserId], references: [id])
  passingScore       Int             @map("passing_score")
  maxAttempts        Int             @map("max_attempts")
  retryWaitHours     Int?            @map("retry_wait_hours")
  completionCriteria Json            @default("{}") @map("completion_criteria")
  syllabusSnapshot   Json            @default("{}") @map("syllabus_snapshot") // temario para constancias
  /// Copiado de la actividad AL PUBLICAR. Es lo que decide si esta ejecucion emite constancia, y
  /// vive aqui porque rige el intento (Decision #27).
  issuesCertificate  Boolean         @default(false) @map("issues_certificate")
  certificateHours   Int?            @map("certificate_hours")
  /// Copiado al publicar. Si viviera solo en la actividad, desmarcarla manana dejaria sin
  /// explicacion las encuestas de eficacia ya programadas y respondidas.
  requiresEfficacy   Boolean         @default(false) @map("requires_efficacy")
  migrationPolicy    MigrationPolicy @default(MOVE_NOT_STARTED) @map("migration_policy")
  estimatedMinutes   Int?            @map("estimated_minutes")

  contents    ActivityContent[]
  offerings   Offering[]
  enrollments Enrollment[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([activityId, versionNumber])
  @@index([activityId, status])
  @@map("activity_versions")
}

model ActivityContent {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  activityVersionId String          @map("activity_version_id") @db.Uuid
  activityVersion   ActivityVersion @relation(fields: [activityVersionId], references: [id], onDelete: Cascade)
  type              ContentType
  title             String
  /// Descripcion editorial de ESTA pieza, no de la actividad. La lee quien cursa.
  description       String?
  displayOrder      Int             @map("display_order")
  isRequired        Boolean         @default(true) @map("is_required")
  config            Json            @default("{}") // min_watch_pct, min_seconds...
  lessonId          String?         @map("lesson_id") @db.Uuid
  lesson            Lesson?         @relation(fields: [lessonId], references: [id])
  contentPackageId  String?         @map("content_package_id") @db.Uuid
  contentPackage    ContentPackage? @relation(fields: [contentPackageId], references: [id])
  assessmentId      String?         @map("assessment_id") @db.Uuid
  assessment        Assessment?     @relation(fields: [assessmentId], references: [id])
  surveyTemplateId  String?         @map("survey_template_id") @db.Uuid
  surveyTemplate    SurveyTemplate? @relation(fields: [surveyTemplateId], references: [id])

  progress ActivityProgress[]

  @@index([activityVersionId, displayOrder])
  @@map("activity_contents")
}

model Lesson {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  title            String
  estimatedMinutes Int?          @map("estimated_minutes")
  status           VersionStatus @default(DRAFT)

  cards    LessonCard[]
  contents ActivityContent[]

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, status, updatedAt])
  @@map("lessons")
}

model LessonCard {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  lessonId     String   @map("lesson_id") @db.Uuid
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  cardType     CardType @map("card_type")
  displayOrder Int      @map("display_order")
  payload      Json     @default("{}")
  mediaKey     String?  @map("media_key")

  @@index([lessonId, displayOrder])
  @@map("lesson_cards")
}

// Inmutable: re-subir = paquete nuevo. SCORM schema-ready (runtime F2, Decision #25).
model ContentPackage {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  kind         PackageKind
  storageKey   String      @map("storage_key")
  originalName String      @map("original_name")
  mimeType     String      @map("mime_type")
  sizeBytes    Int         @map("size_bytes")
  checksum     String
  manifest     Json?
  uploadedBy   String?     @map("uploaded_by") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at")

  contents ActivityContent[]

  @@map("content_packages")
}

// tenant_id NULL = biblioteca global de NEO (visible a todos los tenants; sin RLS por columna nullable
// -> la policy la contempla; ver rls.sql).
model ActivityTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  name      String
  payload   Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("activity_templates")
}

// ──────────────────────── 6.5 Convocatorias y ejecucion ────────────────────────

model Offering {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  activityVersionId String          @map("activity_version_id") @db.Uuid
  activityVersion   ActivityVersion @relation(fields: [activityVersionId], references: [id])
  code              String
  kind              OfferingKind
  modality          Modality

  scheduledDate DateTime? @map("scheduled_date") @db.Date
  startTime     String?   @map("start_time") // HH:mm
  endTime       String?   @map("end_time")
  windowStart   DateTime? @map("window_start") @db.Date // autoservicio / parte virtual
  windowEnd     DateTime? @map("window_end") @db.Date

  // Desglose PESV Paso 10; suma para las 10 h/ano de BPM.
  intensityTheoryHours   Decimal? @map("intensity_theory_hours") @db.Decimal(5, 2)
  intensityPracticeHours Decimal? @map("intensity_practice_hours") @db.Decimal(5, 2)

  instructorUserId        String?    @map("instructor_user_id") @db.Uuid
  instructorExternalName  String?    @map("instructor_external_name")
  instructorCredentialKey String?    @map("instructor_credential_key") // idoneidad adjuntable
  executedBy              ExecutedBy @default(PROPIOS) @map("executed_by")
  executedByOther         String?    @map("executed_by_other")
  /// EL ACTA firmada de la jornada: UN documento para todos los que asistieron, no uno por
  /// persona. Es como se hace de verdad —una hoja que circula y se firma— y pedirla por cabeza
  /// obligaria a subir veinte veces el mismo escaneo.
  attendanceSheetKey      String?    @map("attendance_sheet_key")

  location   String?
  regionalId String?   @map("regional_id") @db.Uuid
  regional   Regional? @relation(fields: [regionalId], references: [id])
  capacity   Int?

  // A QUIENES ATIENDE esta jornada: la TAJADA de los obligados que le toca (Decision #68).
  //
  // Sin esto, dos jornadas de la misma formacion proyectan a los MISMOS obligados y el plan los
  // suma: 40 obligados repartidos en dos jornadas salen como 80 proyectados, y la cobertura no
  // puede pasar del 50% aunque se capacite a todo el mundo.
  //
  // Es una audiencia porque es exactamente eso —un grupo definido por reglas— y asi reutiliza el
  // mismo selector, el mismo calculo de miembros y la misma deduplicacion por forma que Quienes.
  // NULL = atiende a todos los obligados, que es el caso simple y el comportamiento de siempre.
  audienceId String?   @map("audience_id") @db.Uuid
  audience   Audience? @relation(fields: [audienceId], references: [id])

  // Derivado de la regla de asignacion y CONGELADO al publicar (Decision #5).
  projectedCount        Int?      @map("projected_count")
  projectedFrozenAt     DateTime? @map("projected_frozen_at")
  projectedAdjustReason String?   @map("projected_adjust_reason")

  sessionCode          String?   @map("session_code") // QR de asistencia (rotativo)
  sessionCodeExpiresAt DateTime? @map("session_code_expires_at")

  status          OfferingStatus @default(DRAFT)
  cancelledReason String?        @map("cancelled_reason")
  observations    String?

  enrollments Enrollment[]
  attendance  AttendanceRecord[]
  sessionActs SessionAct[]
  planItems   PlanItem[]

  version   Int      @default(1)
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, code])
  @@index([tenantId, status, scheduledDate])
  @@index([activityVersionId])
  @@index([audienceId])
  @@map("offerings")
}

model Enrollment {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  offeringId        String          @map("offering_id") @db.Uuid
  offering          Offering        @relation(fields: [offeringId], references: [id])
  userId            String          @map("user_id") @db.Uuid
  user              User            @relation(fields: [userId], references: [id])
  activityVersionId String          @map("activity_version_id") @db.Uuid // SNAPSHOT de version
  activityVersion   ActivityVersion @relation(fields: [activityVersionId], references: [id])
  assignmentId      String?         @map("assignment_id") @db.Uuid

  status        EnrollmentStatus @default(ENROLLED)
  enrolledAt    DateTime         @default(now()) @map("enrolled_at")
  startedAt     DateTime?        @map("started_at")
  completedAt   DateTime?        @map("completed_at")
  finalScore    Decimal?         @map("final_score") @db.Decimal(5, 2)
  // Por VALOR: titulo, version, nota minima exigida, temario ref, y cargo/area/vinculacion
  // del usuario AL MOMENTO (Decision #33).
  scoreSnapshot Json             @default("{}") @map("score_snapshot")

  blockedAt     DateTime? @map("blocked_at") // intentos agotados -> refuerzo
  blockedReason String?   @map("blocked_reason")
  unblockedBy   String?   @map("unblocked_by") @db.Uuid

  /// ─────────── LA SEGUNDA VIA DE EVIDENCIA: LA ASISTENCIA (Decision #157) ───────────
  ///
  /// Hasta aqui una ejecucion solo se cerraba de UNA forma: la persona entrando a la plataforma
  /// y completando el contenido. En una empresa bajo SG-SST la mayor parte del plan anual se
  /// dicta en salon —charlas de seguridad vial, brigadas, lo que trae la ARL—, y de eso no queda
  /// contenido que completar: queda una LISTA DE ASISTENCIA firmada, que es la evidencia que el
  /// auditor pide. Sin esto, todo lo dictado presencialmente contaba como incumplido.
  attendedAt   DateTime? @map("attended_at")
  /// Quien la marco. Cerrar por asistencia SALTA la evaluacion que exige el tipo —el examen lo
  /// puso el instructor en el salon— asi que tiene que constar quien respondio por ello.
  attendanceBy String?   @map("attendance_by") @db.Uuid

  /// ─────────── LA TERCERA: EL PAPEL DE UN TERCERO (Decision #157) ───────────
  ///
  /// Alturas, espacios confinados, montacargas, manipulacion de alimentos: la norma exige el
  /// certificado de un organismo acreditado, y ahi la empresa es RECEPTORA, no emisora. El
  /// sistema no emite ese papel; lo REGISTRA, porque quien necesita saber cuando vence es la
  /// empresa. Es UNO POR PERSONA —cada quien tiene su numero— a diferencia del acta, que es una
  /// por jornada.
  extCertIssuer     String?   @map("ext_cert_issuer")
  extCertNumber     String?   @map("ext_cert_number")
  extCertIssuedAt   DateTime? @map("ext_cert_issued_at")
  /// LO QUE DICE EL PAPEL, que MANDA sobre lo que calcula el motor: si la ARL certifica por tres
  /// anos y el tipo dice doce meses, vale el papel. Se copia a `assignments.valid_until_override`
  /// para que el motor no tenga que venir hasta aqui a buscarlo.
  extCertValidUntil DateTime? @map("ext_cert_valid_until")
  extCertFileKey    String?   @map("ext_cert_file_key")

  progress ActivityProgress[]
  attempts Attempt[]

  @@unique([offeringId, userId])
  @@index([tenantId, userId, status])
  @@index([offeringId, status])
  @@map("enrollments")
}

model ActivityProgress {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @map("tenant_id") @db.Uuid
  enrollmentId      String          @map("enrollment_id") @db.Uuid
  enrollment        Enrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  activityContentId String          @map("activity_content_id") @db.Uuid
  activityContent   ActivityContent @relation(fields: [activityContentId], references: [id])
  status            ProgressStatus  @default(NOT_STARTED)
  pct               Int             @default(0)
  timeSpentS        Int             @default(0) @map("time_spent_s")
  firstAt           DateTime?       @map("first_at")
  lastAt            DateTime?       @map("last_at")
  data              Json            @default("{}") // suspend_data SCORM futuro

  @@unique([enrollmentId, activityContentId])
  @@map("activity_progress")
}

model AttendanceRecord {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  offeringId    String           @map("offering_id") @db.Uuid
  offering      Offering         @relation(fields: [offeringId], references: [id])
  userId        String           @map("user_id") @db.Uuid
  status        AttendanceStatus
  justification String?
  method        AttendanceMethod
  checkedAt     DateTime         @default(now()) @map("checked_at")
  markedBy      String?          @map("marked_by") @db.Uuid
  signatureKey  String?          @map("signature_key") // imagen de firma en R2 (dato biometrico)

  @@unique([offeringId, userId])
  @@map("attendance_records")
}

// Acta de sesion generada (PDF inmutable).
model SessionAct {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  offeringId    String   @map("offering_id") @db.Uuid
  offering      Offering @relation(fields: [offeringId], references: [id])
  pdfStorageKey String   @map("pdf_storage_key")
  contentHash   String   @map("content_hash")
  generatedAt   DateTime @default(now()) @map("generated_at")
  generatedBy   String   @map("generated_by") @db.Uuid

  @@map("session_acts")
}

// Append-only. Costura xAPI (Decision #28): verbo/objeto/resultado.
model LearningEvent {
  id           BigInt   @id @default(autoincrement())
  tenantId     String   @map("tenant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  enrollmentId String?  @map("enrollment_id") @db.Uuid
  verb         String // LAUNCHED | PROGRESSED | COMPLETED | PASSED | FAILED | ATTENDED | SIGNED | CARD_VIEWED | REVIEW_ANSWERED
  objectType   String   @map("object_type")
  objectId     String   @map("object_id") @db.Uuid
  result       Json     @default("{}")
  occurredAt   DateTime @default(now()) @map("occurred_at")

  @@index([tenantId, userId, occurredAt])
  @@map("learning_events")
}

// ──────────────────── 6.6 Asignacion por regla y requisitos ────────────────────

model Audience {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  name      String
  rule      Json // condiciones sobre job_title/job_title_type/area/regional/employment_type
  isDynamic Boolean @default(true) @map("is_dynamic")
  active    Boolean @default(true)

  members   AudienceMember[]
  // Jornadas cuya TAJADA es esta audiencia (Decision #68).
  offerings Offering[]
  rules     AssignmentRule[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("audiences")
}

// Proyeccion materializada con historia. NUNCA DELETE (Decision #11).
model AudienceMember {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  audienceId String    @map("audience_id") @db.Uuid
  audience   Audience  @relation(fields: [audienceId], references: [id])
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id])
  joinedAt   DateTime  @default(now()) @map("joined_at")
  leftAt     DateTime? @map("left_at")

  @@index([audienceId, userId, leftAt])
  @@map("audience_members")
}

// El "Requisito": obligacion viva en el tiempo (Decision #12).
model AssignmentRule {
  id                  String               @id @default(uuid()) @db.Uuid
  tenantId            String               @map("tenant_id") @db.Uuid
  audienceId          String               @map("audience_id") @db.Uuid
  audience            Audience             @relation(fields: [audienceId], references: [id])
  targetType          AssignmentTargetType @map("target_type")
  targetId            String               @map("target_id") @db.Uuid
  trigger             RuleTrigger
  dueDaysAfterTrigger Int?                 @map("due_days_after_trigger")
  recurrence          Json? // {every_months} | {fixed_date: "01-31"}
  /// Solo obliga a quien entre a la audiencia DESPUES de esta fecha. NULL = a todos, tambien a
  /// los que ya estaban. Es el caso de la puesta en marcha: las inducciones que la plantilla
  /// actual ya hizo en papel no deben aparecerle como pendientes, y eximir 116 veces no es una
  /// salida. No es la GRACIA de `due-date.ts`: la gracia da PLAZO a quien ya estaba; esto decide
  /// si se le exige siquiera.
  appliesFrom         DateTime?            @map("applies_from")
  active              Boolean              @default(true)
  createdBy           String?              @map("created_by") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  assignments Assignment[]

  @@map("assignment_rules")
}

// La OBLIGACION individual. Se retira, nunca se borra (Decision #11).
model Assignment {
  id         String               @id @default(uuid()) @db.Uuid
  tenantId   String               @map("tenant_id") @db.Uuid
  userId     String               @map("user_id") @db.Uuid
  user       User                 @relation(fields: [userId], references: [id])
  targetType AssignmentTargetType @map("target_type")
  targetId   String               @map("target_id") @db.Uuid

  source     AssignmentSource
  ruleId     String?          @map("rule_id") @db.Uuid
  rule       AssignmentRule?  @relation(fields: [ruleId], references: [id])
  planItemId String?          @map("plan_item_id") @db.Uuid
  planItem   PlanItem?        @relation(fields: [planItemId], references: [id])
  assignedBy String?          @map("assigned_by") @db.Uuid

  cycleNumber Int              @default(1) @map("cycle_number") // ronda de recurrencia
  dueAt       DateTime?        @map("due_at")
  status      AssignmentStatus @default(PENDING)

  waivedBy     String? @map("waived_by") @db.Uuid
  waivedReason String? @map("waived_reason")

  /// HASTA CUANDO VALE DE VERDAD, cuando lo dice un papel y no la configuracion (Decision #157).
  ///
  /// La regla general sigue siendo la de la Decision #111: la vigencia sale de la recurrencia, y
  /// pedirla aparte seria pedir el mismo dato dos veces. La excepcion es el certificado de un
  /// TERCERO, donde la fecha no la pone la empresa: la pone quien lo expidio. Si la ARL certifica
  /// por tres anos y el tipo dice doce meses, reclamar al ano seria inventar un incumplimiento.
  ///
  /// Vive aqui y no solo en la inscripcion porque es el motor quien lo necesita —`cycleAnchor`
  /// lo lee para saber desde cuando contar la ronda siguiente— y la obligacion es la fila que el
  /// auditor ya rastrea. `null` es lo normal: sin papel, manda la recurrencia.
  validUntilOverride DateTime? @map("valid_until_override")

  // Enlace asignacion -> ejecucion que la satisfizo (Decision #2: se enlazan, no se fusionan).
  completedEnrollmentId String?   @map("completed_enrollment_id") @db.Uuid
  // Cuando quedo cumplida. Es el ANCLA de la recurrencia ("cada 12 meses desde que la hizo"):
  // sin este dato la ronda siguiente tendria que anclarse al vencimiento, que castiga al que se
  // adelanta y premia al que se atrasa.
  completedAt           DateTime? @map("completed_at")

  assignedAt DateTime @default(now()) @map("assigned_at")

  // Idempotencia del motor de requisitos: una obligacion por regla, persona y ronda. El cron y
  // el alta de una persona pueden correr a la vez sin duplicar nada.
  @@unique([ruleId, userId, cycleNumber])
  @@index([tenantId, userId, status])
  @@index([tenantId, targetType, targetId])
  @@index([tenantId, status, dueAt])
  /// Lo que se vence mirando hacia adelante: la consulta del informe de Vencimientos.
  @@index([tenantId, validUntilOverride])
  @@map("assignments")
}

// ──────────────────── 6.7 Plan de capacitacion anual ────────────────────

// ENTIDAD EMPRESARIAL PROPIA (Decision #3): referencia convocatorias, no posee actividades.
//
// UNO POR ANO (Decision #71). El nombre formaba parte de la clave, asi que "Plan 2026", "Plan
// anual 2026" y "Plan SST 2026" podian convivir, cada uno con su aprobacion, sus proyectados
// congelados y su propio cumplimiento. El auditor pregunta por el plan de 2026 y encontraba tres
// numeros distintos sin forma de saber cual es el bueno. El nombre pasa a ser lo que siempre
// debio ser —texto descriptivo— y el ANO es lo que identifica al plan.
//
// Los planes SST, PESV y BASC no son planes: son la VISTA POR PROCESO del mismo plan anual, que
// ya existe en la pantalla. Es lo que dice CLAUDE.md 3.10 y lo que el modelo no obligaba.
model TrainingPlan {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  year       Int
  name       String
  objective  String?
  // LA META: el porcentaje de cumplimiento del programa que la empresa se compromete a alcanzar
  // este ano (1..100). Antes era `goals`, texto libre, y por eso no se podia comparar contra nada:
  // un indicador sin meta dice "62%" y deja al lector preguntandose si eso es bueno.
  // Se mide contra el CUMPLIMIENTO (ejecutadas / programadas), el indicador del item 1.2.1 de la
  // Res. 0312. Opcional: un plan puede armarse antes de acordar la meta.
  goalPct    Int?       @map("goal_pct")
  scope      String?
  status     PlanStatus @default(DRAFT)
  approvedBy String?    @map("approved_by") @db.Uuid
  approvedAt DateTime?  @map("approved_at")

  items PlanItem[]

  version   Int      @default(1)
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") @db.Uuid

  @@unique([tenantId, year])
  @@map("training_plans")
}

model PlanItem {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  planId            String         @map("plan_id") @db.Uuid
  plan              TrainingPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  offeringId        String         @map("offering_id") @db.Uuid
  offering          Offering       @relation(fields: [offeringId], references: [id])
  plannedMonth      Int            @map("planned_month") // 1..12
  projectedSnapshot Int?           @map("projected_snapshot") // congelado al aprobar el plan
  status            PlanItemStatus @default(PLANNED)
  rescheduledToId   String?        @map("rescheduled_to_item_id") @db.Uuid
  notes             String?

  assignments Assignment[]

  // METRICAS DEL PLAN: exclusivamente enrollments cuyo assignment.source = PLAN y
  // assignment.plan_item_id pertenece al plan (regla de oro 2). Nada externo las altera.

  @@map("plan_items")
}

// ──────────────────── 6.8 Rutas de aprendizaje ────────────────────

model LearningPath {
  id       String        @id @default(uuid()) @db.Uuid
  tenantId String        @map("tenant_id") @db.Uuid
  code     String
  name     String
  status   VersionStatus @default(DRAFT)
  active   Boolean       @default(true)

  items       PathItem[]
  enrollments PathEnrollment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("learning_paths")
}

model PathItem {
  id                   String       @id @default(uuid()) @db.Uuid
  tenantId             String       @map("tenant_id") @db.Uuid
  pathId               String       @map("path_id") @db.Uuid
  path                 LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  sectionName          String?      @map("section_name")
  itemType             PathItemType @map("item_type")
  itemId               String       @map("item_id") @db.Uuid
  displayOrder         Int          @map("display_order")
  isRequired           Boolean      @default(true) @map("is_required")
  minRequiredInSection Int?         @map("min_required_in_section")
  // F1: secuencia lineal. DAG schema-ready sin UI (Decision del informe de dominio).
  prerequisiteItemIds  String[]     @default([]) @map("prerequisite_item_ids") @db.Uuid

  @@map("path_items")
}

model PathEnrollment {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  pathId      String           @map("path_id") @db.Uuid
