// NEO PULSE — Prisma schema v1.0. Fuente: CLAUDE.md seccion 6 (modelo de 5 capas).
// RLS se activa por SQL aparte (prisma/sql/rls.sql) tras migrar. Ver Decision #17.
//
// Convenciones:
//  - tenant_id UUID NOT NULL en toda tabla de datos (sin relacion Prisma hacia Tenant a proposito:
//    evita 50+ back-relations; la integridad la dan RLS + capa ORM tenant-bound).
//  - created_by/updated_by son UUID planos (sin relacion) por la misma razon.
//  - Historicos INMUTABLES (solo INSERT): enrollments snapshots, attempts, grants, certificates,
//    learning_events, audit_logs, audience_members (joined/left, nunca DELETE).
//  - Polimorficos (target_type/target_id, entity_type/entity_id) sin FK formal.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // usuario app (sujeto a RLS)
  directUrl = env("DIRECT_DATABASE_URL") // usuario owner (migraciones/seed)
}

// ─────────────────────────────── Enums ───────────────────────────────

enum DocumentType {
  CEDULA
  CE
  PASAPORTE
  NIT
}

enum EmailKind {
  PERSONAL
  CORPORATE
}

enum EmploymentType {
  DIRECTO
  CONTRATISTA
  TEMPORAL
  EN_MISION
}

// Actor vial (PESV Res. 40595/2022 Paso 10).
enum RoadActor {
  CONDUCTOR
  MOTOCICLISTA
  CICLISTA
  PEATON
  PASAJERO
}

enum Modality {
  PRESENCIAL
  VIRTUAL
  HIBRIDA
}

enum ExecutedBy {
  PROPIOS
  TEMPORALES
  ARL
  EPS
  OTROS
}

enum VersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

// Que pasa con los inscritos al publicar la version N+1 (Decision #6 / regla de oro 4).
enum MigrationPolicy {
  FINISH_OLD
  RESTART_NEW
  MOVE_NOT_STARTED
}

enum ContentType {
  LESSON
  VIDEO
  PRESENTATION
  DOCUMENT
  ASSESSMENT
  SURVEY
  SCORM
  LINK
}

enum CardType {
  TEXT_IMAGE
  VIDEO_SHORT
  QUIZ
  FLIP
  POLL
  FILL_GAP
  // F2: HOTSPOT | MATCH (se agregan cuando exista el bloque)
}

enum PackageKind {
  FILE
  VIDEO
  PRESENTATION
  SCORM_12
  SCORM_2004
}

enum OfferingKind {
  EVENT
  PERMANENT
  HYBRID
}

enum OfferingStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  PASSED
  FAILED
  WITHDRAWN
  EXPIRED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  JUSTIFIED
}

enum AttendanceMethod {
  INSTRUCTOR
  QR
  SIGNATURE
}

enum AssignmentTargetType {
  ACTIVITY
  PATH
  CERTIFICATION
}

enum AssignmentSource {
  MANUAL
  RULE
  PLAN
  STATIC_SNAPSHOT
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  WITHDRAWN_LEFT_AUDIENCE
  // El renglon del plan que la creo se CANCELO. No se borra: quien recibio el aviso de "tu
  // formacion del plan 2026" tiene que poder saber que paso con ella. Cae sola de todas las
  // consultas porque lo abierto se pide por lista blanca (PENDING/IN_PROGRESS/OVERDUE).
  WITHDRAWN_PLAN_ITEM_CANCELLED
  WAIVED
  // CERRO EL PERIODO Y NO LA HIZO. Es lo que faltaba para que una CAMPANA anual pueda pasar de
  // ano: la reinduccion de 2026 se cierra, quien no la hizo queda asi —y eso ES un incumplimiento
  // de 2026, a diferencia de RETIRADA o EXIMIDA, que no cuentan— y la de 2027 nace para todos.
  //
  // Sin este estado el motor solo abria la ronda siguiente si la anterior estaba CUMPLIDA, asi que
  // quien nunca la hacia desaparecia del denominador de todos los anos siguientes: el peor
  // incumplidor salia de la cuenta y la cobertura se veia mejor de lo que era.
  EXPIRED_NOT_DONE
}

// QUE DISPARA la obligacion. El eje es siempre el mismo: quien decide que a esta persona le toca.
enum RuleTrigger {
  ON_JOIN // al entrar a la audiencia
  ON_HIRE // ingreso: due ANTES de hired_at (induccion previa al inicio, D1072)
  SCHEDULED // programada/recurrente
  // LA DISPARA EL PLAN ANUAL, y por eso el motor de requisitos NO la materializa (Decision #76).
  //
  // Una capacitacion del plan no cuelga del ingreso ni de entrar a un grupo ni del calendario:
  // pasa el mes que diga el plan. La regla existe para guardar A QUIENES —que es una decision del
  // analista y hay que poder consultarla antes de aprobar— pero no para generar nada por su
  // cuenta: si generara, cada persona acabaria con dos obligaciones de la misma formacion, con dos
  // vencimientos, y quien ingresara en septiembre entraria en el plan de marzo, que es justo lo
  // que la regla de oro 2 prohibe.
  PLAN
}

enum PlanStatus {
  DRAFT
  APPROVED
  ACTIVE
  CLOSED
}

enum PlanItemStatus {
  PLANNED
  EXECUTED
  RESCHEDULED
  CANCELLED
}

enum PathItemType {
  ACTIVITY
  PATH
}

enum QuestionType {
  SINGLE
  MULTI
  TRUE_FALSE
  ESSAY
  /// Completar huecos: el enunciado lleva {{1}}, {{2}}... y se escriben.
  FILL_BLANK
  /// Ordenar pasos. El tipo que le faltaba a SST: un LOTO o una emergencia son secuencias.
  ORDER
  /// Emparejar dos columnas: senal <-> significado, EPP <-> riesgo.
  MATCH
  /// Un numero con tolerancia y unidad. Sin opciones a la vista que regalen la respuesta.
  NUMERIC
}

enum GradingPolicy {
  HIGHEST
  LAST
  FIRST
  AVERAGE
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  PENDING_MANUAL
}

enum SectionMode {
  FIXED
  RANDOM_FROM_POOL
}

enum SurveyKind {
  SATISFACTION
  EFFICACY
}

enum SurveyResult {
  POSITIVE
  NEGATIVE
  NA
}

enum EfficacyStatus {
  PENDING
  SENT
  RESPONDED
  EXPIRED
}

enum GrantStatus {
  ACTIVE
