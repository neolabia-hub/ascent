  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AiJobTarget {
  LESSON_CARDS
  QUESTIONS
  BOTH
}

enum AiJobStatus {
  QUEUED
  RUNNING
  DRAFT_READY
  APPROVED
  DISCARDED
}

enum NotificationChannel {
