# NEO PULSE — entorno de PRODUCCION del piloto.
#
#   cp .env.prod.example .env.prod    y rellenar.  NUNCA se commitea .env.prod.
#
# Este mismo archivo lo leen dos cosas: Compose (para DOMINIO, IMAGE_*, NEXT_PUBLIC_*) y los
# contenedores de la API (via env_file). Por eso conviven variables de despliegue y de aplicacion.

# ─── Dominio y TLS ───
# El host publico. Con DuckDNS: <lo-que-elijas>.duckdns.org apuntando a la IP de la maquina.
DOMINIO=neopulse.duckdns.org
# Correo para el registro de Let's Encrypt (avisos de caducidad del certificado).
ACME_EMAIL=

# ─── Lo que se hornea en el web al construir la imagen ───
# Mismo dominio que arriba, con https y SIN /v1: el cliente ya le anade el prefijo.
NEXT_PUBLIC_API_URL=https://neopulse.duckdns.org
#
# EL DOMINIO RAIZ, para saber si un subdominio identifica a una empresa.
#
# Con un dominio propio (neopulse.app) se pone ese, y entonces transprensa.neopulse.app entra
# directo a esa empresa. Con un host gratuito de tercer nivel —duckdns.org, vercel.app— NO hay
# subdominio por empresa disponible: se deja VACIO y se entra con ?tenant=transprensa. Ponerlo mal
# es peor que dejarlo vacio, porque el sistema buscaria una empresa que no existe.
NEXT_PUBLIC_ROOT_HOST=
# La empresa por defecto cuando el host no la dice y no viene ?tenant=. Con un solo cliente es lo
# comodo; el dia que entre el segundo hay que quitarlo y obligar a decir cual (ver lib/tenant.ts).
NEXT_PUBLIC_DEV_TENANT=transprensa

# ─── Imagenes (dejar en blanco para construir en la maquina) ───
# Si se construyen fuera y se publican en un registro, aqui van las etiquetas y la maquina solo
# hace `pull`. Es lo recomendado: compilar Next.js pide mas RAM de la que tiene una VM gratuita.
IMAGE_API=
IMAGE_WEB=

# ─── Base de datos ───
POSTGRES_PASSWORD=
# El rol de la APLICACION: esta sujeto a RLS. Es el que usa la API en caliente.
DATABASE_URL=postgresql://neopulse_app:CAMBIAR@postgres:5432/neopulse?schema=public
# El rol DUENO: migra y aplica las policies. No lo usa la aplicacion.
DIRECT_DATABASE_URL=postgresql://neopulse:CAMBIAR@postgres:5432/neopulse?schema=public
# La contrasena del rol de la aplicacion, otra vez y suelta: el release la necesita para CREAR ese
# rol antes de migrar, y de una cadena de conexion no se puede sacar sin adivinar donde acaba.
# TIENE que ser la misma que aparece en DATABASE_URL.
APP_DB_PASSWORD=CAMBIAR
REDIS_URL=redis://redis:6379

# Solo la PRIMERA vez, para sembrar catalogos y la cuenta inicial. Despues se vuelve a poner false.
RUN_SEED=false

# ─── Sesion ───
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Secreto propio, largo y aleatorio: `openssl rand -hex 32`. Cambiarlo cierra todas las sesiones.
REFRESH_TOKEN_PEPPER=
# Firma de las URL de archivos. Si falta, reusa el pepper; mejor tener el suyo.
MEDIA_URL_SECRET=
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

# ─── Archivos: Cloudflare R2 ───
# O estan las CUATRO, o ninguna. Con tres de cuatro la API se niega a arrancar y dice cual falta,
# en vez de fallar en la primera subida con alguien esperando delante.
# Sin ninguna, los archivos van al disco de la maquina (volumen `storage`), que sirve para empezar
# pero mete el video en el ancho de banda del servidor y en el backup.
# Carpeta del disco cuando NO hay R2. Tiene que coincidir con el volumen `storage` del compose:
# si no, los archivos se escriben dentro del contenedor y desaparecen en el siguiente despliegue.
LOCAL_STORAGE_DIR=/app/apps/api/storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ─── Correo ───
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@neopulse.app

# ─── IA (borradores de tarjetas y preguntas; siempre los revisa una persona) ───
ANTHROPIC_API_KEY=

# ─── Aplicacion ───
NODE_ENV=production
PORT=3002
FRONTEND_URL=https://neopulse.duckdns.org
PUBLIC_VERIFY_BASE_URL=https://neopulse.duckdns.org/verificar
APP_TIMEZONE=America/Bogota
# Proxies propios DELANTE de la API. Con este compose, Caddy es uno: 1.
# De menos, toda la empresa comparte el limite por IP; de mas, cualquiera se inventa la suya.
TRUSTED_PROXY_HOPS=1

# ─── Observabilidad (opcional) ───
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
